# Database (SQLite for development)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# Frontend URL (for CORS)
# Comma-separated allowed origins; add the Tauri webview origins for the desktop app
FRONTEND_URL="http://localhost:5173,tauri://localhost,http://tauri.localhost"
# Chrome used for PDF export. Leave unset to use Puppeteer's downloaded browser
# (`npx puppeteer browsers install chrome`), or point it at an installed Chrome.
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/google-chrome"
