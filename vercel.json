{
  "framework": "vite",
  "buildCommand": "prisma generate --schema backend/prisma/schema.prisma && npm run build",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1769,
      "includeFiles": "shared/resume/preview.css"
    }
  }
}
